{
  "name": "github-trends-site",
  "version": "1.3.0",
  "private": true,
  "description": "基于 GitHub REST API 的开源项目趋势统计网站（纯静态，零运行时依赖）",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:seo": "node scripts/serve.mjs 4180 _prerendered",
    "fetch": "node scripts/fetch-trending.mjs",
    "fetch:once": "node scripts/fetch-trending.mjs --once",
    "prerender": "node scripts/prerender.mjs",
    "build": "node scripts/prerender.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "node scripts/check-contrast.mjs && node scripts/prerender.mjs && node scripts/check-seo.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "github",
    "trending",
    "static-site",
    "github-pages",
    "seo",
    "rss"
  ],
  "license": "MIT"
}
